# AstrBot 只监听服务器本机，不要把 6185 暴露到公网。
ASTRBOT_BASE_URL=http://127.0.0.1:6185
ASTRBOT_API_KEY=请填写具有chat和im权限的完整密钥
# 在目标私聊中发送 /sid，填写AstrBot返回的完整UMO，不要只填旧式会话ID。
ASTRBOT_TARGET_UMO=平台ID:FriendMessage:会话ID
# 如记忆系统按user_id绑定，请填写对应用户ID；公开仓库中不要填写真实号码。
ASTRBOT_CHAT_USERNAME=touch_pet_user
# 留空时自动复用ASTRBOT_TARGET_UMO，让触摸信号进入目标私聊的同一个上下文。
# 只有明确需要隔离桌宠对话时，才填写独立值，例如 touch_pet_signal。
ASTRBOT_CHAT_SESSION_ID=

# 自己生成一段足够长的随机令牌，提供给手机配对。
TOUCH_PET_PAIR_TOKEN=请替换为至少32位随机字符串
COOLDOWN_SECONDS=30
MAX_REQUESTS_PER_HOUR=60
ASTRBOT_TIMEOUT_SECONDS=120
# AstrBot 4.x 会话数据库；服务只读 conversations 表，不读取 platform_message_history。
ASTRBOT_CONTEXT_DB_PATH=/AstrBot/data/data_v4.db
ASTRBOT_CONTEXT_LIMIT=10
LOG_LEVEL=INFO

# 四种信号都可以换成适合你角色的文字。
SIGNAL_TAP=用户戳了你一下
SIGNAL_LONG_PRESS=用户正在抚摸你
SIGNAL_DRAG=用户拖动了你
SIGNAL_DOUBLE_TAP=用户连续戳了你两下
